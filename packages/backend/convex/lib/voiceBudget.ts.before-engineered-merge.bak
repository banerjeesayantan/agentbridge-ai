/**
 * Paid-voice budget configuration. Pure: reads an env-like object.
 *
 * Fail closed: anything REQUIRED that is missing or invalid makes `ready`
 * false, and the backend refuses to authorize paid calls. Nothing here is a
 * provider price: the per-minute worst-case cost is operator-supplied.
 *
 *   VOICE_BUDGET_PRO_MICRO          monthly voice budget, micro-dollars (default 14_750_000)
 *   VOICE_BUDGET_BUSINESS_MICRO     monthly voice budget, micro-dollars (default 49_750_000)
 *   VOICE_PAID_MAX_CALL_SECONDS     REQUIRED. Must equal maxDurationSeconds on every managed assistant.
 *   VOICE_MAX_COST_PER_MINUTE_MICRO REQUIRED. Worst-case provider cost per minute, micro-dollars.
 *   VOICE_ALLOWED_ORIGINS           REQUIRED. Comma-separated origins that host the widget.
 *   VOICE_TOKEN_TTL_SECONDS         default 300 (60..900)
 *   VOICE_START_GRACE_SECONDS       default 120 (0..3600): slack after token expiry + max duration
 *   VOICE_MAX_CONCURRENT_PER_ORG    default 1 (1..20)
 *   VOICE_MAX_AUTHORIZATIONS_PER_SESSION default 5 (1..100)
 */

export type PaidPlan = "pro" | "business";

export interface VoiceBudgetConfig {
  ready: boolean;
  planBudgetMicro: Record<PaidPlan, number>;
  maxCallSeconds: number;
  maxCostPerMinuteMicro: number;
  /** Amount held per authorized call: worst-case cost of a maximum-length call. */
  reservationMicro: number;
  tokenTtlSeconds: number;
  startGraceSeconds: number;
  maxConcurrentPerOrg: number;
  maxAuthorizationsPerSession: number;
  allowedOrigins: string[];
}

type Env = Record<string, string | undefined>;

const unset = (raw: string | undefined) => raw === undefined || raw.trim() === "";

function parseIntInRange(raw: string | undefined, min: number, max: number): number | null {
  if (unset(raw)) return null;
  const n = Number(raw);
  return Number.isInteger(n) && n >= min && n <= max ? n : null;
}

/** Optional integer with a default. A value that is SET but invalid returns "invalid". */
function optionalInt(raw: string | undefined, fallback: number, min: number, max: number): number | "invalid" {
  if (unset(raw)) return fallback;
  return parseIntInRange(raw, min, max) ?? "invalid";
}

export function parseOrigins(raw: string | undefined): string[] {
  if (unset(raw)) return [];
  const out: string[] = [];
  for (const part of raw!.split(",")) {
    const value = part.trim();
    if (!value) continue;
    try {
      const url = new URL(value);
      if ((url.protocol !== "https:" && url.protocol !== "http:") || url.origin === "null") return [];
      if (!out.includes(url.origin)) out.push(url.origin);
    } catch {
      return []; // one bad entry invalidates the whole list (fail closed)
    }
  }
  return out;
}

export function readVoiceBudgetConfig(env: Env): VoiceBudgetConfig {
  // Budgets: unset => documented default; set-but-invalid => 0 (denies).
  const budget = (raw: string | undefined, fallback: number) => {
    if (unset(raw)) return fallback;
    const n = Number(raw);
    return Number.isSafeInteger(n) && n >= 0 ? n : 0;
  };

  const maxCallSeconds = parseIntInRange(env.VOICE_PAID_MAX_CALL_SECONDS, 10, 43_200);
  const costPerMinute = parseIntInRange(env.VOICE_MAX_COST_PER_MINUTE_MICRO, 1, 1_000_000_000);
  const allowedOrigins = parseOrigins(env.VOICE_ALLOWED_ORIGINS);
  const tokenTtl = optionalInt(env.VOICE_TOKEN_TTL_SECONDS, 300, 60, 900);
  const grace = optionalInt(env.VOICE_START_GRACE_SECONDS, 120, 0, 3_600);
  const concurrent = optionalInt(env.VOICE_MAX_CONCURRENT_PER_ORG, 1, 1, 20);
  const perSession = optionalInt(env.VOICE_MAX_AUTHORIZATIONS_PER_SESSION, 5, 1, 100);

  const ready =
    maxCallSeconds !== null &&
    costPerMinute !== null &&
    allowedOrigins.length > 0 &&
    tokenTtl !== "invalid" &&
    grace !== "invalid" &&
    concurrent !== "invalid" &&
    perSession !== "invalid";

  const callSeconds = maxCallSeconds ?? 0;
  const perMinute = costPerMinute ?? 0;
  return {
    ready,
    planBudgetMicro: {
      pro: budget(env.VOICE_BUDGET_PRO_MICRO, 14_750_000),
      business: budget(env.VOICE_BUDGET_BUSINESS_MICRO, 49_750_000),
    },
    maxCallSeconds: callSeconds,
    maxCostPerMinuteMicro: perMinute,
    reservationMicro: Math.ceil((callSeconds * perMinute) / 60),
    tokenTtlSeconds: tokenTtl === "invalid" ? 0 : tokenTtl,
    startGraceSeconds: grace === "invalid" ? 0 : grace,
    maxConcurrentPerOrg: concurrent === "invalid" ? 0 : concurrent,
    maxAuthorizationsPerSession: perSession === "invalid" ? 0 : perSession,
    allowedOrigins,
  };
}

/**
 * The latest moment a call authorized with a token expiring at `tokenExpiresAt`
 * can still exist: the token must be used before it expires, and the assistant's
 * hard maximum duration then ends the call. Until this moment the hold is never
 * released without provider evidence.
 */
export function holdDeadline(
  tokenExpiresAt: number,
  cfg: Pick<VoiceBudgetConfig, "maxCallSeconds" | "startGraceSeconds">,
): number {
  return tokenExpiresAt + (cfg.maxCallSeconds + cfg.startGraceSeconds) * 1000;
}
