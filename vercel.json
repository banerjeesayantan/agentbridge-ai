{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "widget": {
      "root": "apps/widget",
      "framework": "nextjs"
    },
    "embed": {
      "root": "apps/embed",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/embed/(.*)",
      "destination": {
        "service": "embed"
      }
    },
    {
      "source": "/widget",
      "destination": {
        "service": "widget"
      }
    },
    {
      "source": "/widget/(.*)",
      "destination": {
        "service": "widget"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
